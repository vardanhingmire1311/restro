# PostgreSQL. Local default matches docker-compose and a stock postgres install.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restro_db

# Required in production. Development falls back to an insecure built-in value.
JWT_SECRET=replace-with-a-long-random-string

APP_URL=http://127.0.0.1:3847
PORT=3847
TZ=Asia/Kolkata
NODE_ENV=development

# Set when the browser is on another origin (Vercel) than the API (Render).
# NEXT_PUBLIC_API_URL=https://restro.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://restro.onrender.com
# CLIENT_ORIGIN=https://your-app.vercel.app
# COOKIE_SECURE=true

# UPI. restro@upi is a placeholder and does not receive money.
UPI_VPA=restro@upi
UPI_PAYEE_NAME=Restro

# Card gateways. Leave blank to use only the built-in sandbox.
# Test card on the sandbox page: 4111111111111111
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# PhonePe Business sandbox. Checkout is attempted only when both are set.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT=
PHONEPE_SALT_INDEX=1
# PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Paytm is intentionally not initiated. See README.
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# Aggregator webhooks. Required in production unless you explicitly opt into open mocks.
AGGREGATOR_WEBHOOK_SECRET=
# ALLOW_OPEN_WEBHOOKS=true

# Guest OTP. With neither provider set, the code is printed in the server log.
# OTP_DEV_REVEAL=true also returns it in the API during non-production.
OTP_DEV_REVEAL=true
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google Sign-In for guests. Both values are required or the button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon and some hosts need TLS. rejectUnauthorized stays off unless you set this to true.
# PGSSL_REJECT_UNAUTHORIZED=true
